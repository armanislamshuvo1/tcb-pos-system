# ==============================================================================
# TCB POS & Staff Tab Management System - Frontend Environment Variables
# ==============================================================================
#
# USAGE INSTRUCTIONS:
# 1. Local Development:
#    Copy this file to `.env.local`:
#      cp .env.example .env.local
#    Next.js will automatically load `.env.local` during `npm run dev`.
#
# 2. Production Deployment (Vercel, Render, Railway, Docker, AWS):
#    Set these variables in your hosting provider's Environment Dashboard
#    BEFORE triggering `npm run build`. Next.js inlines `NEXT_PUBLIC_*`
#    variables into client-side JS at BUILD TIME.
# ==============================================================================

# Backend API Base URL (Express 5 Server)
# - Local Dev:   http://localhost:5000
# - Production:  https://api.yourdomain.com (or https://your-backend.onrender.com)
# NOTE: Do NOT add a trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Application Display & Settings (Optional)
# NEXT_PUBLIC_APP_NAME="TCB POS & Tab Manager"
# NEXT_PUBLIC_CURRENCY_SYMBOL="$"
